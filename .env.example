# ---- Core ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to "true" ONLY on the production domain. Staging must stay unindexed.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# ---- Database (Postgres) ----
DATABASE_URL="postgresql://user:password@host:5432/medisure?schema=public"

# ---- Auth (admin panel) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ---- Payments: Razorpay ----
# Test keys during development. The webhook secret is what makes a booking
# confirmable — never confirm from the browser callback.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Notifications ----
# SMS (MSG91 or Twilio) — used for OTP, confirmations and reminders
SMS_PROVIDER="console"   # console | msg91 | twilio
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""

# Email (Resend)
EMAIL_PROVIDER="console" # console | resend
RESEND_API_KEY=""
EMAIL_FROM="MediSure Hospital <no-reply@example.com>"

# Front desk gets an alert on every booking
FRONT_DESK_EMAIL=""

# ---- Cron ----
# Protects /api/cron/* from public invocation
CRON_SECRET=""

# ---- Media uploads ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
