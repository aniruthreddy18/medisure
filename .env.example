# =============================================================================
# MediSure Hospital — environment
#
# Copy to .env and fill in. The site RUNS WITHOUT ANY OF THE OPTIONAL VALUES:
# payments fall back to a pending state,
# and Google Sheets logs the row instead of writing it. Nothing crashes.
#
# Never commit the filled-in .env. Never paste these values into chat.
# =============================================================================

# ---- Core (required) --------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# "true" ONLY on the live domain. Staging must stay out of Google.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# ---- Database (required) ----------------------------------------------------
# Local dev: `npm run db:dev` starts Postgres and prints these.
# Use the PLAIN form below — do not add the idle/pool/socket timeout params it
# suggests, they cause dropped connections.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=5"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=5"

# ---- Admin auth (required before launch) ------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""

# ---- Razorpay (optional — bookings stay "payment pending" without it) --------
# From Razorpay Dashboard → Settings → API Keys. Use TEST keys first.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks. Point the webhook at:
#   https://YOUR-DOMAIN/api/payments/webhook
# Subscribe to: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=""

# ---- Google Sheets mirror (optional — rows are logged if unset) -------------
# 1. Google Cloud → create a service account → download its JSON key
# 2. Share the spreadsheet with that service account's email (Editor)
# 3. Create a tab named exactly "Bookings"
# Either a path to the file, or the JSON itself (for hosts with no disk).
GOOGLE_CREDENTIALS=""
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
SPREADSHEET_ID=""

# ---- SMS ------------------------------------------------------------------
# Removed. Bookings are no longer phone-verified, so nothing sends SMS.


# ---- Email (optional) -------------------------------------------------------
EMAIL_PROVIDER="console"        # console | resend
RESEND_API_KEY=""
EMAIL_FROM="MediSure Hospital <no-reply@example.com>"
FRONT_DESK_EMAIL=""

# ---- Cron (required in production) ------------------------------------------
# Protects /api/cron/expire-holds, which returns abandoned places to the queue.
# openssl rand -hex 32
CRON_SECRET=""

# ---- Media uploads (optional) -----------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
