{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/book/success/[ref]",
      "regex": "^/book/success/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPref": "nxtPref"
      },
      "namedRegex": "^/book/success/(?<nxtPref>[^/]+?)(?:/)?$"
    },
    {
      "page": "/doctors/[slug]",
      "regex": "^/doctors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/doctors/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/manage/[ref]",
      "regex": "^/manage/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPref": "nxtPref"
      },
