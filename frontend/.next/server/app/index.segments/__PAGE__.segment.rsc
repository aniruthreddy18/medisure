7:["$","$L19",null,{"departments":[{"id":"cmsyz3khk0000dqxzhsb2nrl3","name":"Physiotherapy & Rehabilitation","slug":"physiotherapy","icon":"Activity","shortDesc":"Restore movement after injury, surgery or stroke — at the hospital or in your home.","longDesc":"Our physiotherapy team treats pain and restricted movement with hands-on therapy, graded exercise and rehabilitation planning. We run a dedicated home physiotherapy service for patients who cannot travel, including post-surgical and neurological rehabilitation.","conditions":[{"id":"cmsyz3kik0005dqxzug4duv41","name":"Post-Surgical Rehabilitation","slug":"post-surgical-rehabilitation"},{"id":"cmsyz3kip0006dqxz1go6by8e","name":"Stroke & Neurological Rehab","slug":"stroke-neurological-rehab"},{"id":"cmsyz3kis0007dqxzcophakzn","name":"Back & Neck Pain","slug":"back-and-neck-pain"},{"id":"cmsyz3kiu0008dqxzbxws41ld","name":"Sports Injury Rehabilitation","slug":"sports-injury-rehabilitation"},{"id":"cmsyz3kiw0009dqxzkla7s8wr","name":"Geriatric Mobility & Falls","slug":"geriatric-mobility"}],"doctorCount":8},{"id":"cmsyz3ki10001dqxz9bfkq3co","name":"Orthopaedics","slug":"orthopaedics","icon":"Bone","shortDesc":"Joint replacement, fracture care, spine and sports injury treatment.","longDesc":"The orthopaedic department manages the full range of bone and joint conditions — from fractures and sports injuries to knee and hip replacement and degenerative spine disease, supported by on-site imaging and a physiotherapy team for recovery.","conditions":[{"id":"cmsyz3kix000adqxzmydl11af","name":"Knee Replacement","slug":"knee-replacement"},{"id":"cmsyz3kiz000bdqxz97ntfhlx","name":"Hip Replacement","slug":"hip-replacement"},{"id":"cmsyz3kj0000cdqxzw5gwg4ki","name":"Fracture & Trauma Care","slug":"fracture-and-trauma-care"},{"id":"cmsyz3kj2000ddqxznfi27v97","name":"Arthroscopy & Sports Injury","slug":"arthroscopy-sports-injury"},{"id":"cmsyz3kj4000edqxz1e3f9cae","name":"Spine Care","slug":"spine-care"}],"doctorCount":6},{"id":"cm